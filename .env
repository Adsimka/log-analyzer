# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=log_clustering
POSTGRES_USER=app
POSTGRES_PASSWORD=secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Application
APP_PORT=8000
LOG_LEVEL=INFO

# ML Model
SBERT_MODEL_NAME=all-MiniLM-L6-v2

# Filtering
ACCEPTED_LOG_LEVELS=ERROR,WARN

# Clustering schedule (seconds)
CLUSTERING_INTERVAL_SECONDS=300

# Clustering defaults
DEFAULT_PERIOD=24h
UMAP_N_COMPONENTS=10
UMAP_N_NEIGHBORS=30
UMAP_MIN_DIST=0.0
HDBSCAN_MIN_CLUSTER_SIZE=2
HDBSCAN_MIN_SAMPLES=2
HDBSCAN_CLUSTER_SELECTION_METHOD=eom